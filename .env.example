# AI grading: set one. Groq is used if both are set.
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# Optional cloud database (see supabase/schema.sql). Leave empty to store sessions in data/sessions.json.
# Server-only: never prefix these with NEXT_PUBLIC_. The publishable key is not needed.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
