# AI grading: set one. Groq is used if both are set.
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# Supabase (Project Settings). Server-only: never prefix these with NEXT_PUBLIC_.
# Project URL, bare: https://<ref>.supabase.co (no /rest/v1)
SUPABASE_URL=
# Publishable key (sb_publishable_...): what the app uses. Row-level security limits it to the signed-in user's rows.
SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...): bypasses security. Only used by scripts/claim-sessions.ts, never by the app.
SUPABASE_SECRET_KEY=
